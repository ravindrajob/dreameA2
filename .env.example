# ==============================================================================
# Dreame A2 3D LiDAR Cockpit - Configuration Environment
# ==============================================================================

# Home Assistant connection
HA_URL=http://192.0.2.100:8123
HA_TOKEN=your_home_assistant_long_lived_access_token_here

# Entity IDs in Home Assistant (customizable to match your setup)
MOWER_ENTITY_ID=lawn_mower.a2
RAIN_SENSOR_ENTITY_ID=binary_sensor.dreame_roboticmower_a2_dreame_a2_rain_sensor

# Cockpit security (optional token required to send physical commands via API)
API_AUTH_TOKEN=your_secure_random_token_here

# Server port
PORT=8000
